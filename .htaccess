Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:php|database|uploads|routes|views|scripts|middleware|node_modules)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env(?:\..*)?|package\.json|package-lock\.json|database\.js|server\.js)$ - [F,L,NC]
RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
RewriteRule ^css/(.*)$ public/css/$1 [L,NC]
RewriteRule ^js/(.*)$ public/js/$1 [L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
</IfModule>
