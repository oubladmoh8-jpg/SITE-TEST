NODE_ENV=development
PORT=3000

# Generate a long random secret locally, for example with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS

# SQLite file path, relative to the repository root unless absolute
DATABASE_PATH=./database/database.sqlite

# Owner account is seeded only when OWNER_PASSWORD_HASH is a valid bcrypt hash.
# Generate one locally with: node scripts/hash-password.js
OWNER_USERNAME=admin
OWNER_EMAIL=admin@localhost.invalid
OWNER_PASSWORD_HASH=CHANGE_ME

# Maximum upload size in MB per project file (images have a separate 10 MB cap)
UPLOAD_MAX_MB=100

# Optional Google OAuth. Leave both values empty to disable Google login.
# Create OAuth credentials in Google Cloud Console and register the callback URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional Discord OAuth. Leave both values empty to disable Discord login.
# Create an application in the Discord Developer Portal and register the callback URL below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# OAuth login requires the provider to return a verified email address.
# OAuth accounts are not automatically linked to an existing password account by email.
